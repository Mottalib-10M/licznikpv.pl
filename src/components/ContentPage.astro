---
/**
 * Strona z `src/content/pages/` (RECETTE §9.3, §21). Strona-narzędzie : H1, wstęp, narzędzie, akapit
 * do cytowania zwinięty, treść. Poradnik : H1, wstęp, akapit do cytowania, mini-symulator, treść.
 * FAQ, powiązane strony, źródła i ramka wydawcy pochodzą z PageLayout (FAQ widoczne = FAQ w schemacie).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Tool from './tools/Tool';
import Clamp from './Clamp.astro';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { P, sourceUrl } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const H = helpers(lang);
const parts = x.body(H).split(/<!--(mini:[A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: sourceUrl(k) }));
const methodHref = route('method', lang);
const TARGET: Record<string, string> = { pv: 'home', rozliczenie: 'depozyt-prosumencki', cieplo: 'pompa-ciepla-koszt-ogrzewania', dotacje: 'czyste-powietrze-kalkulator' };
const miniHref = route(ROUTES.some((r) => r.id === TARGET[page.group]) ? TARGET[page.group] : 'home', lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-4">
      <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    </header>
    {page.tool ? (
      <>
        <div data-outil class="mb-4"><Tool client:load tool={page.tool} arg={page.toolArg} lang={lang} id={page.id} methodHref={methodHref} /></div>
        <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        <p class="mb-8 text-sm text-navy-700">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
      </>
    ) : (
      <>
        <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} />}
        <p class="mb-8 text-sm text-navy-700">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
      </>
    )}
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div data-chrome><MiniSim client:load kind={p.slice(5)} lang={lang} href={miniHref} /></div>)}
    </div>
  </article>
</PageLayout>
