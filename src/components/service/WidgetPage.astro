---
/** Kalkulator na Twoją stronę / Embed (pl, en), noindex. */
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route, type Locale } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const pl = lang === 'pl';
const q = pl ? '' : '?lang=en';
const label = pl ? 'Kalkulator fotowoltaiki' : 'Solar calculator';
const code = `<iframe src="${SITE_URL}/embed/kalkulator-fotowoltaiki/${q}" title="${label}" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title={pl ? 'Kalkulator fotowoltaiki na Twoją stronę, bezpłatnie' : 'Embed the Polish solar calculator on your site for free'} description={pl ? 'Osadź bezpłatnie kalkulator fotowoltaiki 2026 dla każdej gminy za pomocą iframe: skopiuj kod, bez konta i bez plików cookie, ceny PSE i taryfy aktualizują się same.' : 'Embed the 2026 solar calculator for every Polish gmina free of charge with an iframe: copy the code, no account and no cookies, PSE prices and tariffs update themselves.'} lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: pl ? 'Start' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{pl ? 'Kalkulator fotowoltaiki na Twoją stronę' : 'Embed the solar calculator'}</h1>
    <p class="mt-3 text-lg text-navy-700">{pl ? 'Dla gmin, punktów doradztwa energetycznego, stowarzyszeń i lokalnych redakcji: kopiujesz raz, a ceny i taryfy aktualizują się same.' : 'For municipalities, energy advice desks, associations and local newsrooms: copy once, and prices and tariffs update themselves.'}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>{pl ? 'Kod do skopiowania' : 'Code to copy'}</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{pl ? 'Warunki: link do źródła pod kalkulatorem pozostaje widoczny, kalkulator nie jest modyfikowany i jest udostępniany bez gwarancji. To, co wpisują Twoi czytelnicy, zostaje na ich urządzeniu; ramka nie zapisuje plików cookie i niczego nie mierzy.' : 'Terms: the source link under the calculator stays visible, the calculator is not modified, and it is provided without warranty. What your readers type stays on their device; the frame sets no cookies and measures nothing.'} <a href={route('contact', lang)}>{pl ? 'Pytania' : 'Questions'}</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/kalkulator-fotowoltaiki/${q}`} title={label} width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
