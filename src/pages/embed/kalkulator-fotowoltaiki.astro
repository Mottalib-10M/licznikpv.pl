---
/** Strona do osadzenia (iframe) : kalkulator bez nawigacji. noindex, poza mapą strony. ?lang=en zmienia język. */
import '../../styles/global.css';
import PvCalc from '../../components/tools/PvCalc';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalkulator fotowoltaiki 2026</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/pl/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <div id="pl-view"><PvCalc client:load lang="pl" id="empl" /></div>
    <div id="en-view" hidden><PvCalc client:load lang="en" id="emen" /></div>
    <p class="mt-2 text-center text-xs text-navy-600"><a id="credit" href={`${SITE_URL}/pl/`} target="_blank" rel="noopener" class="underline">Kalkulator fotowoltaiki 2026 · {SITE_NAMES.pl}</a></p>
    <script is:inline>
      if (new URLSearchParams(location.search).get('lang') === 'en') { document.getElementById('pl-view').hidden = true; document.getElementById('en-view').hidden = false; document.documentElement.lang = 'en'; var c = document.getElementById('credit'); c.textContent = 'Solar calculator 2026 · Licznik PV'; c.href = c.href.replace('/pl/', '/en/'); }
    </script>
  </body>
</html>
